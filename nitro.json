{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["audioanvil"],
  "ios": {
    "iosModuleName": "NitroAudioAnvil"
  },
  "android": {
    "androidNamespace": ["audioanvil"],
    "androidCxxLibName": "NitroAudioAnvil"
  },
  "autolinking": {
    "AnvilFactory": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridAnvilFactory"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridAnvilFactory"
      }
    }
  },
  "ignorePaths": ["**/node_modules", "lib"],
  "gitAttributesGeneratedFlag": true
}
